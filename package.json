{
  "name": "nunjucks-template",
  "displayName": "Nunjucks Template",
  "description": "Formatting, Syntax Highlighting, Hover, and Snippets for Nunjucks",
  "version": "0.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eseom/nunjucks-template"
  },
  "license": "MIT",
  "publisher": "eseom",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:njk"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "title": "NunjucksTemplate",
      "properties": {
        "nunjucksTemplate.preserveEmptyLine": {
          "type": "number",
          "default": 0,
          "description": "empty lines number to keep at formatting"
        },
        "nunjucksTemplate.useNewParser": {
          "type": "boolean",
          "default": false,
          "description": "Use new experimental Jinja/Nunjucks parser instead of prettydiff"
        }
      }
    },
    "snippets": [
      {
        "language": "njk",
        "path": "./assets/snippets/snippets.json"
      }
    ],
    "commands": [],
    "languages": [
      {
        "id": "njk",
        "aliases": [
          "Nunjucks",
          "njk"
        ],
        "extensions": [
          ".njk"
        ],
        "configuration": "./assets/languages/configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "njk",
        "scopeName": "source.njk",
        "path": "./assets/syntaxes/njk.json"
      },
      {
        "language": "njk",
        "scopeName": "source.html",
        "path": "./assets/syntaxes/html.json"
      },
      {
        "language": "njk",
        "scopeName": "text.html.njk",
        "path": "./assets/syntaxes/njk-html.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "prettydiff": "^101.2.6"
  }
}
